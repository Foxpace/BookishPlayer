{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bookish: Debug",
      "flutterMode": "debug",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/${input:app}",
      "program": "${workspaceFolder}/apps/${input:app}/lib/main.dart",
      "preLaunchTask": "Bookish: resolve workspace"
    },
    {
      "name": "Bookish: Profile",
      "flutterMode": "profile",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/${input:app}",
      "program": "${workspaceFolder}/apps/${input:app}/lib/main.dart",
      "preLaunchTask": "Bookish: resolve workspace"
    },
    {
      "name": "Bookish: Release",
      "flutterMode": "release",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/${input:app}",
      "program": "${workspaceFolder}/apps/${input:app}/lib/main.dart",
      "preLaunchTask": "Bookish: resolve workspace"
    },
    {
      "name": "Bookish core: All tests",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/packages/bookish_player",
      "program": "test",
      "preLaunchTask": "Bookish: resolve workspace"
    },
    {
      "name": "Cactus adapter: All tests",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/packages/bookish_cactus_transcription",
      "program": "test",
      "preLaunchTask": "Bookish: resolve workspace"
    }
  ],
  "inputs": [
    {
      "id": "app",
      "type": "pickString",
      "description": "Which Bookish app should run?",
      "options": [
        "store",
        "internal"
      ],
      "default": "store"
    }
  ]
}
