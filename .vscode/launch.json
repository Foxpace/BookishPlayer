      "flutterMode": "debug"
    },
    {
      "name": "Bookish Store (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/store",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Bookish Store (Release)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/store",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Bookish Internal (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/internal",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Bookish Internal (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/internal",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Bookish Internal (Release)",
